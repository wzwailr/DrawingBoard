{
  "name": "drawingboard",
  "version": "0.0.1-p0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=24.0.0 <25" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "package:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "link:vendor/excalidraw/packages/excalidraw",
    "@excalidraw/element": "link:vendor/excalidraw/packages/element",
    "@excalidraw/common": "link:vendor/excalidraw/packages/common",
    "@excalidraw/math": "link:vendor/excalidraw/packages/math",
    "react": "19.3.1", "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "jsdom": "22.1.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "yarn": "1.22.22"
  }
}
